{
  "schema": "phantom.camera_rig",
  "schema_version": "1.0.0",
  "rig_name": "desk_frame_c270",
  "notes": [
    "Single source of truth for the physical rig: the mount generator (camera/hardware/c270_frame) and the software (nominal poses, synthetic fixtures) both read this file.",
    "Frame axes = world axes: right-handed, metres, +X right, +Y away from the viewer, +Z up, origin at the centre of the frame footprint on the tabletop. The calibrated world origin is the checkerboard origin; place the board origin here."
  ],
  "frame": {
    "width_m": 1.0,
    "depth_m": 0.6,
    "height_m": 0.5,
    "tube": "3/4 in schedule 40 PVC (any rigid round tube works; set tube_od_mm)",
    "tube_od_mm": 26.7,
    "overhead_crossbar_y_m": 0.055
  },
  "camera_model": {
    "name": "logitech_c270",
    "image_width": 1280,
    "image_height": 720,
    "fps": 30,
    "fourcc": "MJPG",
    "diagonal_fov_deg": 55.0,
    "fixed_focus": true,
    "body_mm": {"width": 73.0, "height": 32.0, "depth": 30.0}
  },
  "cameras": [
    {
      "id": "cam_1",
      "role": "overhead",
      "source": {"kind": "uvc", "unique_id": null, "linux_by_path": null, "index": 0, "name_contains": "C270"},
      "mount": {"tube": "top_crossbar", "tube_axis": "x", "tube_point_m": [0.0, 0.055, 0.5], "lens_offset_from_tube_mm": [0.0, -55.0, -12.0]},
      "look_at_m": null,
      "look_direction": [0.0, 0.0, -1.0]
    },
    {
      "id": "cam_2",
      "role": "back_left",
      "source": {"kind": "uvc", "unique_id": null, "linux_by_path": null, "index": 1, "name_contains": "C270"},
      "mount": {"tube": "top_back_rail", "tube_axis": "x", "tube_point_m": [-0.4, 0.3, 0.5], "lens_offset_from_tube_mm": [0.0, -55.0, -15.0]},
      "look_at_m": [0.0, 0.0, 0.0]
    },
    {
      "id": "cam_3",
      "role": "back_right",
      "source": {"kind": "uvc", "unique_id": null, "linux_by_path": null, "index": 2, "name_contains": "C270"},
      "mount": {"tube": "top_back_rail", "tube_axis": "x", "tube_point_m": [0.4, 0.3, 0.5], "lens_offset_from_tube_mm": [0.0, -55.0, -15.0]},
      "look_at_m": [0.0, 0.0, 0.0]
    }
  ],
  "sync": {"pair_tolerance_ms": 20.0},
  "calibration_file": "calibration/data/rig_calibration.json"
}
