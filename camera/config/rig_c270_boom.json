        "unique_id": null,
        "linux_by_path": null,
        "index": 0,
        "name_contains": "C270"
      },
      "mount": {
        "tube": "boom_head",
        "tube_axis": "x",
        "tube_point_m": [
          0.0,
          0.0,
          0.995
        ],
        "lens_offset_from_tube_mm": [
          0.0,
          0.0,
          -85.0
        ]
      },
      "look_at_m": null,
      "look_direction": [
        0.0,
        0.0,
        -1.0
      ],
      "orientation": "portrait"
    }
  ],
  "sync": {
    "pair_tolerance_ms": 20.0
  },
  "calibration_file": "calibration/data/rig_calibration_boom.json"
}
