# WebSocket URL for the real backend. Only used in "Live" mode; Mock mode needs none of this.
VITE_WS_URL=ws://localhost:8000/ws/world

# Local Cartesia proxy (integrations/cartesia/server.mjs). Leave unset to use the default.
VITE_CARTESIA_PROXY_URL=http://localhost:8787/speak
VITE_CARTESIA_STT_WS_URL=ws://localhost:8787/stt

# Local voicecontrol key-injection proxy (integrations/voicecontrol/server.mjs).
VITE_VOICECONTROL_PROXY_URL=http://localhost:8789/key-transition

# Set once a real Convex deployment exists. Leave unset to stay in mock mode.
# VITE_CONVEX_URL=

# Agent 3's tilt_keys websocket hub (backend/tilt_keys/run.py --input ws).
# Held-key visualization only — this frontend never injects keystrokes itself.
VITE_KEYS_WS_URL=ws://localhost:8765/ws/keys
