# WebSocket URL for the real backend. Only used in "Live" mode; Mock mode needs none of this.
VITE_WS_URL=ws://localhost:8000/ws/world

# Local Cartesia proxy (integrations/cartesia/server.mjs). Leave unset to use the default.
VITE_CARTESIA_PROXY_URL=http://localhost:8787/speak

# Set once a real Convex deployment exists. Leave unset to stay in mock mode.
# VITE_CONVEX_URL=

# Local gamecontrol proxy (integrations/gamecontrol/server.mjs). Leave unset to use the default.
VITE_GAME_CONTROL_PROXY_URL=http://localhost:8788/press
